const int lightOne = 19;
const int lightTwo = 5;

const int pwmHz = 1000;
const int bitDepth = 8;

int lightValue = 0;
int changeStep = 5;

void setup() {
  ledcAttach(lightOne, pwmHz, bitDepth);
  ledcAttach(lightTwo, pwmHz, bitDepth);
}

void loop() {
  ledcWrite(lightOne, lightValue);
  ledcWrite(lightTwo, 255 - lightValue);

  lightValue += changeStep;

  if (lightValue <= 0 || lightValue >= 255) {
    changeStep = -changeStep;
  }

  delay(20);
}
